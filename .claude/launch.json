{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tegel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "tegel-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "tegel-pages",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "BASE_PATH=/dutch-personal-training/ npx vite preview --port 4174 --strictPort"
      ],
      "port": 4174
    }
  ]
}